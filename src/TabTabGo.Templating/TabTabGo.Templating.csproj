<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Abstract implementation of TabTabGo's Templating engine</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Templating</PackageTags>
  </PropertyGroup>

  <!-- Microsoft.Extensions.Options, DependencyInjection.Abstractions and Configuration.Abstractions (IOptions<T>, IServiceCollection, IConfiguration in the public API)
       ship in the net11.0 shared framework (Microsoft.NETCore.App 11.0): NU1510 refuses an explicit reference. A consumer gets the types from the platform. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Templating.Dotliquid" />
    <InternalsVisibleTo Include="TabTabGo.Templating.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo@32.png" Pack="true" PackagePath="" Link="logo@32.png" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
