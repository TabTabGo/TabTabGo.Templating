<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>DotLiquid's implementation of TabTabGo's Templating engine</Description>
    <RootNamespace>TabTabGo.Templating.Liquid</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Templating;Liquid;DotLiquid</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="Humanizer.Core.ar" />
    <PackageReference Include="DotLiquid" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Templating.DotLiquid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Templating\TabTabGo.Templating.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo@32.png" Pack="true" PackagePath="" Link="logo@32.png" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
