<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>DotLiquid's implementation of TabTabGo's Templating engine</Description>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TabTabGo.Templating.Liquid</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Templating;Liquid;DotLiquid</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="DotLiquid" Version="2.3.260" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Templating.DotLiquid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Templating\TabTabGo.Templating.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo@32.png" Pack="true" PackagePath="" Link="logo@32.png" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
